# Copy to ".env" (same folder, or ~/.gamba/.env) and fill in your key.
# Anything already set in your shell environment wins over this file.
# ".env" is gitignored; ".env.example" is not - never put a real key here.

# --- default names -----------------------------------------------------
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- or your own name, paired with --api-key-env / model.api_key_env ---
# MY_SCREEN_KEY=sk-proj-...

# --- a custom OpenAI-compatible endpoint -------------------------------
# GAMBA_API_KEY=...
